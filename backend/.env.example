# Copy this file to backend/.env and replace the example values.
PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
# Public browser key; Express sends this value to the page at /app-config.js.
SUPABASE_ANON_KEY=your-public-anon-key
# Keep the service-role key private; it must never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
